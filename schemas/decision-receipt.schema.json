{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-decision-receipt.org/schemas/decision-receipt.schema.json",
  "title": "Open Decision Receipt v0.2 RC2",
  "description": "A replayable record of evidence, authority, scope, execution, boundary, and accountability for an AI-enabled or workflow-mediated decision.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "decision_id",
    "workflow",
    "decision_type",
    "risk_class",
    "request",
    "check",
    "recommendation",
    "authority",
    "execution",
    "boundary",
    "accountability",
    "receipt"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "decision_type": {
      "type": "string",
      "minLength": 1
    },
    "risk_class": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "authorized",
        "denied",
        "escalated",
        "needs_human_review",
        "unknown",
        "sealed",
        "revoked"
      ]
    },
    "parent_receipt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reopen_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "requester",
        "requester_authority",
        "requested_action",
        "requested_at"
      ],
      "properties": {
        "requester": {
          "type": [
            "string",
            "null"
          ]
        },
        "requester_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_action": {
          "type": "string",
          "minLength": 1
        },
        "requested_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow", "action_type", "parameters"],
          "properties": {
            "workflow": {"type": "string", "minLength": 1},
            "action_type": {"type": "string", "minLength": 1},
            "parameters": {"type": "object"}
          }
        },
        "action_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "checked_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_seen": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "query_language",
                      "query",
                      "result_hash",
                      "canonicalization",
                      "queried_at"
                    ],
                    "properties": {
                      "type": {
                        "const": "structured_query"
                      },
                      "query_language": {
                        "type": "string",
                        "minLength": 1
                      },
                      "query": {
                        "type": "string",
                        "minLength": 1
                      },
                      "result_hash": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      },
                      "canonicalization": {
                        "type": "string",
                        "minLength": 1
                      },
                      "queried_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "source_system": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_snapshot_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "query_engine_version": {
                        "type": "string",
                        "minLength": 1
                      },
                      "result_artifact_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "result_summary": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            }
          ]
        },
        "context_hash_at_check": {
          "type": [
            "string",
            "null"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dissenting_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority_snapshot": {
          "type": [
            "object",
            "null"
          ]
        },
        "authority_hash_at_check": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "recommended_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "recommendation": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "approver": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_method": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "explicit",
            "policy",
            "delegated",
            "break_glass",
            "none",
            "unknown",
            null
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "action_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "separation_of_duties_ok": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "authorization_use": {
          "enum": [
            "single_use"
          ]
        },
        "consumed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "consumed_by_execution_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_path": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resolver_version",
            "bundle",
            "bundle_version",
            "actor",
            "risk_class",
            "action",
            "requires_human",
            "edges",
            "dependency_ids",
            "path_hash"
          ],
          "properties": {
            "resolver_version": {"const": "1"},
            "bundle": {"type": "string", "minLength": 1},
            "bundle_version": {"type": ["integer", "string"]},
            "actor": {"type": "string", "minLength": 1},
            "risk_class": {"enum": ["low", "medium", "high", "critical"]},
            "action": {"type": "string", "minLength": 1},
            "requires_human": {"type": "boolean"},
            "expires_at": {"type": ["string", "null"]},
            "edges": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["subject", "relationship", "object"],
                "properties": {
                  "subject": {"type": "string", "minLength": 1},
                  "relationship": {"type": "string", "minLength": 1},
                  "object": {"type": "string", "minLength": 1}
                }
              }
            },
            "dependency_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "path_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "executed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "executed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_or_system": {
          "type": [
            "string",
            "null"
          ]
        },
        "credential_used": {
          "type": [
            "string",
            "null"
          ]
        },
        "actual_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow", "action_type", "parameters"],
          "properties": {
            "workflow": {"type": "string", "minLength": 1},
            "action_type": {"type": "string", "minLength": 1},
            "parameters": {"type": "object"}
          }
        },
        "action_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "context_hash_at_execution": {
          "type": [
            "string",
            "null"
          ]
        },
        "execution_result": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "allowed_actions": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "denied_actions": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "failure_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "fail_closed",
            "fail_open",
            "unknown",
            null
          ]
        },
        "rollback_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "accountability": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "accountable_owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_required_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "appeal_or_escalation_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "prompt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_output_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replayable": {
          "type": "boolean"
        },
        "integrity_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "sealed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
